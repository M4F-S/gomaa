# Mnemosyne — environment template
# Copy to `.env` and fill in your real values. NEVER commit `.env`.

# --- Memory database (PostgreSQL + pgvector) ---
MEMORY_DB_DSN=postgresql://mnemosyne:password@localhost:5432/mnemosyne
SHARED_DB_DSN=postgresql://mnemosyne:password@localhost:5432/shared_memory
MEMORY_VAULT_PATH=./vault
MEMORY_AGENT_NAME=local-agent
MEMORY_REQUIRE_POSTGRES=true

# --- Embedding microservice (optional) ---
# EMBED_SERVICE_URL=http://localhost:8765
# EMBED_SERVICE_PORT=8765
# EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- VPS deployment (scripts/vps.sh) ---
# VPS_HOST=127.0.0.1
# VPS_USER=root
# VPS_PORT=22
# DEPLOY_DIR=/opt/mnemosyne
# DB_HOST=localhost
# DB_PORT=5432
# DB_PASSWORD=change-me
# ALLOW_UNCONFIGURED=0

# --- Google Drive sync (optional) ---
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GDRIVE_SERVICE_ACCOUNT_JSON={...}
# GDRIVE_TOKEN_JSON={...}